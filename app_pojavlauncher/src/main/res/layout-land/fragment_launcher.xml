<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111215"
    android:padding="24dp">

    <TextView
        android:id="@+id/launcher_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NovaLauncher"
        android:textColor="#E4E6EB"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/control_dock"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="@drawable/rounded_card_bg"
        android:backgroundTint="#1D1E22"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/account_layer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="24dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="＋"
                android:textColor="#A0A5B5"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Account"
                android:textColor="#A0A5B5"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/links_row"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/account_layer">

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="Wiki"
                android:textColor="#707585"
                android:textSize="12sp"
                android:layout_marginHorizontal="12dp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/social_media_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="Discord"
                android:textColor="#707585"
                android:textSize="12sp"
                android:layout_marginHorizontal="12dp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="Controls"
                android:textColor="#707585"
                android:textSize="12sp"
                android:layout_marginHorizontal="12dp" />
        </LinearLayout>

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_card_bg"
            android:backgroundTint="#26272B"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/play_button" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_card_bg"
            android:backgroundTint="#ADC1F9"
            android:text="Launch"
            android:textColor="#1A2035"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/install_jar_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/share_logs_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/open_files_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <ImageButton android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
