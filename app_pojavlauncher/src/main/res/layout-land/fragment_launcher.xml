<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F12"
    android:padding="16dp">

    <TextView
        android:id="@+id/launcher_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOVA LAUNCHER"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="12dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/control_dock"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="@drawable/rounded_card_bg"
        android:backgroundTint="#1A1A22"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <GridLayout
            android:id="@+id/mini_action_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="1"
            android:alignmentMode="alignMargins"
            app:layout_constraintTop_toTopOf="parent">

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/rounded_card_bg"
                android:backgroundTint="#252530"
                android:gravity="center"
                android:padding="8dp"
                android:textSize="10sp"
                android:text="WIKI"
                android:textColor="#FFFFFF"
                android:drawableTop="@drawable/ic_px_book" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/social_media_button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/rounded_card_bg"
                android:backgroundTint="#252530"
                android:gravity="center"
                android:padding="8dp"
                android:textSize="10sp"
                android:text="DISCORD"
                android:textColor="#FFFFFF"
                android:drawableTop="@drawable/ic_social_media" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/rounded_card_bg"
                android:backgroundTint="#252530"
                android:gravity="center"
                android:padding="8dp"
                android:textSize="10sp"
                android:text="CONTROLS"
                android:textColor="#FFFFFF"
                android:drawableTop="@drawable/ic_px_gamepad" />
        </GridLayout>

        <TextView
            android:id="@+id/txt_account_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ Profile Context"
            android:textColor="#8A8A9E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/mini_action_grid"
            app:layout_constraintStart_toStartOf="parent" />

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_card_bg"
            android:backgroundTint="#252530"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/txt_account_label" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/rounded_card_bg"
            android:backgroundTint="#5B7CFA"
            android:text="LAUNCH GAME"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/install_jar_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/share_logs_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/open_files_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <ImageButton android:id="@+id/edit_profile_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
