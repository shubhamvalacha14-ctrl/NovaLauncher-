<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121316"
    android:clickable="true"
    android:focusable="true"
    android:padding="20dp">

    <RelativeLayout
        android:id="@+id/version_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back_versions"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#E2E4E9" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_versions"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:text="Version List"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/tab_filters_row"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/version_header">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="All"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="@drawable/rounded_card_bg"
            android:backgroundTint="#25262B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Vanilla"
            android:textColor="#8B8F9D"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:layout_marginStart="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Moddable"
            android:textColor="#8B8F9D"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/version_list_render"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tab_filters_row"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
